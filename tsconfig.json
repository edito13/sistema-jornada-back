{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./src/types", "./src/interfaces"],
    "types": ["node", "express"]
  },
  "include": ["src/**/*", "server.ts"],
  "exclude": ["node_modules", "dist"]
}
